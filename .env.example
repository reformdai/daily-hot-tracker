# AI API Keys (选择一个即可)
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# AI 提供商选择: deepseek / openai / anthropic
AI_PROVIDER=deepseek

# 飞书 Webhook URL
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx

# Product Hunt API Token (可选)
PRODUCTHUNT_TOKEN=

# 原文补抓兜底 (可选)：页面需浏览器渲染时用 Jina Reader；Key 可不填但限流更严
JINA_READER_FALLBACK=false
JINA_API_KEY=

# 时效窗口 (小时，0 关闭) 与送 AI 的候选数 (可选)
MAX_ITEM_AGE_HOURS=72
AI_CANDIDATE_LIMIT=40
